# ─────────────────────────────────────────────────────────────────────────────
# Eazi Studio — Environment Variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Authentication + Database) ─────────────────────────────────────
# Find in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Database (Supabase Postgres via PgBouncer pooler) ────────────────────────
# Find in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler (port 6543) with pgbouncer=true for Vercel
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ── GitHub Models API (AI — GPT-4o / GPT-4o-mini) ───────────────────────────
# Generate in: GitHub → Settings → Developer Settings → Personal Access Tokens
# Requires access to GitHub Models (models.github.ai)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ── YouTube Data API ──────────────────────────────────────────────────────────
# Obtain from: Google Cloud Console → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_data_api_key

# ── Firebase Client SDK (Browser-side) ───────────────────────────────────────
# Obtain from: Firebase Console → Project Settings → General → Web App config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:your_app_id

# ── Firebase Admin SDK (Server-side only) ────────────────────────────────────
# Obtain from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the ENTIRE minified JSON object as a single-line string (keep the outer single quotes on Linux/Mac)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'
