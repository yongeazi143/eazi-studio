{
  "_meta": {
    "version": "1.0.0",
    "source": "4 screenshots — AI video generation web app + mobile onboarding + thumbnail tool",
    "designPersonality": "Modern AI-product aesthetic. Two distinct modes: light-lavender (web wizard flow), dark-space (marketing/landing), warm-dark (mobile onboarding). All share: rounded corners, glassmorphism cards, gradient accents, soft ambient glows.",
    "doNotRules": [
      "DO NOT apply card background gradients to icon fills — icons use solid white or brand color, not the card gradient",
      "DO NOT apply button gradient to text inside the button — button text is always solid #FFFFFF",
      "DO NOT apply the page background gradient to card surfaces — cards have their own lighter or frosted surface",
      "DO NOT use primary purple gradient on secondary/ghost buttons — secondary buttons use transparent or low-opacity fills",
      "DO NOT add hard drop shadows to text elements — shadows belong on card containers and modals only",
      "DO NOT apply border-radius: 9999px to card containers — pill radius is reserved for tags, badges, and small chips only",
      "DO NOT reuse the dark landing page background (#0D0B1E) inside the light wizard flow — each context has its own base color",
      "DO NOT apply ambient glow effects to inline text or body copy — glows are reserved for hero headlines and CTA buttons",
      "DO NOT mix gradient directions: hero glows use radial, button fills use linear (135deg or 90deg)",
      "DO NOT place borders on frosted-glass cards that already have a backdrop-blur — they use a single subtle rgba border, not a solid color border"
    ]
  },

